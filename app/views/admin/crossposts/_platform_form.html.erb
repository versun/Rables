<%# locals: platform, crosspost, title, description, enabled_label, field_rows, max_characters_hint, fetch_comments, verify_fields %>
<div class="form-section compact" data-controller="crosspost-form">
  <h3><%= title %></h3>
  <small><%= description %></small>

  <%= form_with(model: crosspost, url: admin_crosspost_path(crosspost.platform), method: :patch,
      data: { crosspost_form_target: "main", action: "input->crosspost-form#sync change->crosspost-form#sync" }) do |f| %>
    <%= f.hidden_field :platform, value: platform %>

    <div class="field checkbox">
      <%= f.check_box :enabled, id: "crosspost_enabled_#{platform}" %>
      <%= f.label :enabled, enabled_label, for: "crosspost_enabled_#{platform}" %>
    </div>

    <% field_rows.each do |row| %>
      <% if row.size > 1 %>
        <div class="form-grid form-grid-2">
          <% row.each do |field, label, placeholder| %>
            <div class="field">
              <%= f.label field, label %>
              <%= f.text_field field, placeholder: placeholder %>
            </div>
          <% end %>
        </div>
      <% else %>
        <% field, label, placeholder = row.first %>
        <div class="field">
          <%= f.label field, label %>
          <%= f.text_field field, placeholder: placeholder %>
        </div>
      <% end %>
    <% end %>

    <div class="field">
      <%= f.label :max_characters, "Max Characters", for: "crosspost_max_characters_#{platform}" %>
      <%= f.number_field :max_characters, min: 1, placeholder: crosspost.default_max_characters, value: crosspost.max_characters || crosspost.default_max_characters, id: "crosspost_max_characters_#{platform}" %>
      <small><%= max_characters_hint %></small>
    </div>

    <% if fetch_comments %>
      <div class="field checkbox">
        <%= f.check_box :auto_fetch_comments %>
        <%= f.label :auto_fetch_comments, "Auto-fetch Comments" %>
      </div>
      <div class="field">
        <%= f.label :comment_fetch_schedule, "Comment Fetch Schedule" %>
        <%= f.select :comment_fetch_schedule,
            options_for_select([
              ['Disabled', ''],
              ['Daily at 12:00 AM', 'daily'],
              ['Weekly on Monday at 12:00 AM', 'weekly'],
              ['Monthly on 1st at 12:00 AM', 'monthly']
            ], crosspost.comment_fetch_schedule),
            {},
            { class: "form-select" } %>
        <small>
          Select the frequency for automatically fetching comments. All fetches run at 12:00 AM (midnight).
        </small>
      </div>
    <% end %>

    <div class="form-actions">
      <%= f.submit "Save", class: 'btn btn-primary' %>
      <div id="verify-button-<%= platform %>">
        <%= button_tag "Verify", type: 'submit', class: 'btn btn-secondary', form: "verify-form-#{platform}", data: { turbo_frame: "_top" } %>
      </div>
    </div>
  <% end %>

  <%= form_with(url: verify_admin_crosspost_path(platform), method: :post,
      data: { turbo: true, crosspost_form_target: "verify", action: "submit->crosspost-form#sync" }, id: "verify-form-#{platform}") do |vf| %>
    <%= hidden_field_tag 'crosspost[platform]', platform %>
    <% verify_fields.each do |field| %>
      <%= hidden_field_tag "crosspost[#{field}]", crosspost.public_send(field), id: "verify_#{field}_#{platform}" %>
    <% end %>
  <% end %>
  <div id="verify-messages-<%= platform %>"></div>
</div>
