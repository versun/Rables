<div class="admin-container">
  <h1>Crosspost Settings</h1>

  <div class="admin-toolbar">
    <div class="status-tabs">
      <% platform_tabs = {
        "mastodon" => "Mastodon",
        "twitter" => "X (Twitter)",
        "bluesky" => "Bluesky",
        "xiaohongshu" => "Xiaohongshu"
      } %>
      <% platform_tabs.each do |platform, label| %>
        <%= link_to label, admin_crossposts_path(platform: platform), class: "status-tab #{@active_platform == platform ? 'active' : ''}" %>
      <% end %>
    </div>
  </div>

  <% if @active_platform == "mastodon" %>
    <%= render "platform_form",
        platform: "mastodon",
        crosspost: @mastodon,
        title: "Mastodon",
        description: "Get credentials: Open Mastodon → Preferences → Development → New application | Scope: profile,write:statuses",
        enabled_label: "Enable Mastodon CrossPost",
        field_rows: [
          [[:server_url, "Mastodon Server URL", "https://mastodon.social"], [:client_key, "Client Key", nil]],
          [[:client_secret, "Client Secret", nil], [:access_token, "Access Token", nil]]
        ],
        max_characters_hint: 'Maximum characters for posts. If content exceeds this limit, a "Read more" link will be added. Default: 500',
        fetch_comments: true,
        verify_fields: %i[server_url client_key client_secret access_token] %>
  <% end %>

  <% if @active_platform == "twitter" %>
    <%= render "platform_form",
        platform: "twitter",
        crosspost: @twitter,
        title: "X (Twitter)",
        description: "First, obtain X credentials from #{link_to('https://developer.x.com', 'https://developer.x.com', target: '_blank')}".html_safe,
        enabled_label: "Enable X CrossPost",
        field_rows: [
          [[:access_token, "Access Token", nil], [:access_token_secret, "Access Token Secret", nil]],
          [[:api_key, "API Key", nil], [:api_key_secret, "API Key Secret", nil]]
        ],
        max_characters_hint: 'Maximum characters for posts. If content exceeds this limit, a "Read more" link will be added. Default: 250 (non-ASCII characters count as 2)',
        fetch_comments: false,
        verify_fields: %i[access_token access_token_secret api_key api_key_secret] %>
  <% end %>

  <% if @active_platform == "bluesky" %>
    <%= render "platform_form",
        platform: "bluesky",
        crosspost: @bluesky,
        title: "Bluesky",
        description: "Get credentials: Log in to your Bluesky account and generate an App Password in settings.",
        enabled_label: "Enable Bluesky CrossPost",
        field_rows: [
          [[:username, "Username", "your.handle"], [:app_password, "App Password", nil]],
          [[:server_url, "Server URL", "https://bsky.social/xrpc"]]
        ],
        max_characters_hint: 'Maximum characters for posts. If content exceeds this limit, a "Read more" link will be added. Default: 300',
        fetch_comments: true,
        verify_fields: %i[username app_password server_url] %>
  <% end %>

  <% if @active_platform == "xiaohongshu" %>
  <div class="form-section compact">
    <h3>Xiaohongshu</h3>
    <small>No public API available. These fields are for reference and manual posting.</small>

    <%= form_with(model: @xiaohongshu, url: admin_crosspost_path(@xiaohongshu.platform), method: :patch) do |f| %>
      <%= f.hidden_field :platform, value: 'xiaohongshu' %>

      <div class="field checkbox">
        <%= f.check_box :enabled, id: 'crosspost_enabled_xiaohongshu' %>
        <%= f.label :enabled, "Enable Xiaohongshu CrossPost", for: 'crosspost_enabled_xiaohongshu' %>
      </div>

      <div class="form-grid form-grid-2">
        <div class="field">
          <%= f.label :username, "Username (optional)" %>
          <%= f.text_field :username, placeholder: "your_id" %>
        </div>

        <div class="field">
          <%= f.label :server_url, "Profile URL (optional)" %>
          <%= f.text_field :server_url, placeholder: "https://www.xiaohongshu.com/user/profile/..." %>
        </div>
      </div>

      <div class="field">
        <%= f.label :max_characters, "Max Characters", for: 'crosspost_max_characters_xiaohongshu' %>
        <%= f.number_field :max_characters, min: 1, placeholder: "300", value: @xiaohongshu.max_characters || @xiaohongshu.default_max_characters, id: 'crosspost_max_characters_xiaohongshu' %>
        <small>
          Maximum characters for manual posts. Default: <%= @xiaohongshu.default_max_characters %>
        </small>
      </div>

      <div class="form-actions">
        <%= f.submit "Save", class: 'btn btn-primary' %>
      </div>
    <% end %>
  </div>
  <% end %>

</div>
