<div class="admin-container">
  <h1>Migrate</h1>

  <div class="admin-toolbar">
    <div class="status-tabs">
      <%= link_to "Export", admin_migrates_path(tab: "export"), class: "status-tab #{@active_tab == 'export' ? 'active' : ''}" %>
      <%= link_to "Import", admin_migrates_path(tab: "import"), class: "status-tab #{@active_tab == 'import' ? 'active' : ''}" %>
    </div>
  </div>

  <% if @active_tab == "export" %>
  <% if @exports.any? { |export| export.pending? || export.running? } %>
    <% content_for :head do %><meta http-equiv="refresh" content="5"><% end %>
  <% end %>
  <div class="form-section compact">
    <h3>Export Data</h3>

    <div class="form-grid form-grid-2">
      <div>
        <h4>Full Backup</h4>
        <p>Create a ZIP archive containing a snapshot of the SQLite database and all uploaded files.</p>
        <p><small>The export runs in the background; the ZIP appears in the list below when it is ready to download.</small></p>
        <%= form_with url: admin_migrates_path, method: :post, data: { turbo: false } do |f| %>
          <%= hidden_field_tag :operation_type, 'export' %>
          <%= f.submit "Create Backup", class: "btn btn-primary" %>
        <% end %>
      </div>

      <div>
        <h4>Go Migration Package</h4>
        <p>Create the one-way migration package (rendered HTML, images, JSONL metadata) for the Go rewrite.</p>
        <p><small>Also available on the server via <code>bin/rails "site:export"</code>. See docs/go-migration-prompt.md for the package format.</small></p>
        <%= form_with url: admin_migrates_path, method: :post, data: { turbo: false } do |f| %>
          <%= hidden_field_tag :operation_type, 'site_export' %>
          <%= f.submit "Export for Go Migration", class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>

    <% if @exports.any? %>
    <h4>Recent Exports</h4>
    <div class="table-container">
      <table class="admin-table compact-table">
        <thead>
          <tr>
            <th>Type</th>
            <th>Status</th>
            <th>Started</th>
            <th>Size</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @exports.each do |export| %>
            <tr>
              <td><%= export.backup? ? "Full Backup" : "Go Migration" %></td>
              <td>
                <%= export.status %>
                <% if export.failed? && export.error.present? %>
                  <br><small><%= export.error %></small>
                <% end %>
              </td>
              <td><%= export.created_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td><%= export.byte_size ? number_to_human_size(export.byte_size) : "—" %></td>
              <td>
                <% if export.file_available? %>
                  <%= link_to "Download", download_admin_export_path(export), data: { turbo: false } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% end %>
  </div>
  <% end %>

  <% if @active_tab == "import" %>
  <div class="form-section compact">
    <h3>Import Data</h3>

    <div class="form-grid form-grid-2">
      <div>
        <h4>Import from RSS</h4>
        <p>Import articles from an RSS feed URL</p>
        <%= form_with url: admin_migrates_path, method: :post, data: { turbo: false }, multipart: true do |f| %>
          <%= hidden_field_tag :operation_type, 'import' %>

          <div class="field">
            <%= label_tag :url, "RSS URL" %>
            <%= text_field_tag :url, nil, placeholder: "https://example.com/feed.xml" %>
          </div>

          <div class="field checkbox">
            <%= check_box_tag :import_images, '1', false %>
            <%= label_tag :import_images, "Import Images" %>
          </div>

          <%= f.submit "Import From RSS", class: "btn btn-primary" %>
        <% end %>
      </div>

      <div>
        <h4>Restore from Backup</h4>
        <p>Upload a backup ZIP file created by the export.</p>
        <%= form_with url: admin_migrates_path, method: :post, data: { turbo: false }, multipart: true do |f| %>
          <%= hidden_field_tag :operation_type, 'import' %>

          <div class="field">
            <%= label_tag :backup_file, "Backup File" %>
            <%= file_field_tag :backup_file, accept: ".zip" %>
            <small>Warning: restoring replaces the entire current database and all uploaded files.</small>
            <small>The restore runs during the request and can take a while on large sites; don't close the page or restart the server until it finishes.</small>
          </div>

          <%= f.submit "Restore Backup", class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>

</div>
